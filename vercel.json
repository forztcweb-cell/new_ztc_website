{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/solutions",
      "destination": "/solutions/index.html"
    },
    {
      "source": "/solutions/",
      "destination": "/solutions/index.html"
    },
    {
      "source": "/solutions/industries",
      "destination": "/solutions/industries/index.html"
    },
    {
      "source": "/solutions/industries/",
      "destination": "/solutions/industries/index.html"
    },
    {
      "source": "/solutions/intelligence",
      "destination": "/solutions/intelligence/index.html"
    },
    {
      "source": "/solutions/intelligence/",
      "destination": "/solutions/intelligence/index.html"
    },
    {
      "source": "/solutions/engineering",
      "destination": "/solutions/engineering/index.html"
    },
    {
      "source": "/solutions/engineering/",
      "destination": "/solutions/engineering/index.html"
    },
    {
      "source": "/solutions/research",
      "destination": "/solutions/research/index.html"
    },
    {
      "source": "/solutions/research/",
      "destination": "/solutions/research/index.html"
    },
    {
      "source": "/solutions/publications",
      "destination": "/solutions/publications/index.html"
    },
    {
      "source": "/solutions/publications/",
      "destination": "/solutions/publications/index.html"
    },
    {
      "source": "/solutions/publications/building-intelligence-across-industries",
      "destination": "/solutions/publications/building-intelligence-across-industries/index.html"
    },
    {
      "source": "/solutions/publications/building-intelligence-across-industries/",
      "destination": "/solutions/publications/building-intelligence-across-industries/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
